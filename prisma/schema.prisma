// Orbtrade database schema (PostgreSQL on Neon).
//
// Conventions:
// - Secrets (session tokens, verification codes, recovery codes) are stored only
//   as HMAC hashes. Sensitive data (TOTP secrets, KYC files) is AES-256-GCM
//   encrypted at the application layer before it reaches the database.
// - Table and column names are snake_case in Postgres, camelCase in TypeScript.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SUPPORT
  COMPLIANCE
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id    String @id @default(cuid())
  /// Always stored lower-cased and trimmed.
  email String @unique
  name  String

  passwordHash String @map("password_hash")

  emailVerifiedAt DateTime? @map("email_verified_at")
  /// E.164 format, e.g. +447700900123. Unique once verified.
  phone           String?   @unique
  phoneVerifiedAt DateTime? @map("phone_verified_at")

  /// Encrypted TOTP secret; set once 2FA is confirmed.
  totpSecretEnc        String?   @map("totp_secret_enc")
  /// Encrypted secret awaiting confirmation during 2FA setup.
  totpPendingSecretEnc String?   @map("totp_pending_secret_enc")
  totpEnabledAt        DateTime? @map("totp_enabled_at")
  /// Last accepted TOTP time step; codes at or before it are rejected (replay protection).
  totpLastStep         Int?      @map("totp_last_step")
  /// Set when the user has seen the optional 2FA step (enabled or skipped).
  twoFactorPromptedAt  DateTime? @map("two_factor_prompted_at")

  role      Role          @default(USER)
  status    AccountStatus @default(ACTIVE)
  kycStatus KycStatus     @default(NONE) @map("kyc_status")
  /// 0 = unverified, 1 = identity verified. Limits by level arrive with funding (Phase 4).
  kycLevel  Int           @default(0) @map("kyc_level")

  termsAcceptedAt DateTime @map("terms_accepted_at")
  termsVersion    String   @map("terms_version")
  locale          String   @default("en")
  /// ISO 4217 code (lower-case) for showing balances in local currency.
  currency        String   @default("usd")
  /// Short code used in the user's referral link (/r/CODE).
  referralCode    String?  @unique @map("referral_code")
  referredById    String?  @map("referred_by_id")
  referredBy      User?    @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals       User[]   @relation("Referrals")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions          Session[]
  verificationCodes VerificationCode[]
  authChallenges    AuthChallenge[]
  recoveryCodes     RecoveryCode[]
  securityEvents    SecurityEvent[]
  kycSubmissions    KycSubmission[]    @relation("KycSubmitter")
  kycReviews        KycSubmission[]    @relation("KycReviewer")
  accounts          Account[]
  watchlist         WatchlistItem[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  journalEntries    JournalEntry[]
  deposits          Deposit[]
  depositAddresses  DepositAddress[]
  orders            Order[]
  withdrawals       Withdrawal[]
  withdrawalAddrs   WithdrawalAddress[]
  auditLogs         AdminAuditLog[]
  priceAlerts       PriceAlert[]
  recurringBuys     RecurringBuy[]
  rewardsEarned     ReferralReward[]   @relation("RewardReferrer")
  rewardsReceived   ReferralReward[]   @relation("RewardReferee")
  supportTickets    SupportTicket[]    @relation("TicketCustomer")
  assignedTickets   SupportTicket[]    @relation("TicketAssignee")
  supportMessages   SupportMessage[]
  apiKeys           ApiKey[]
  testimonials      Testimonial[]

  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  /// HMAC-SHA256 of the random token held in the httpOnly cookie.
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?   @map("user_agent")
  device     String?
  location   String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  /// Absolute expiry; idle timeout is enforced from last_seen_at.
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

enum CodePurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
  WITHDRAWAL_CONFIRM
  ADDRESS_CONFIRM
}

/// One-time 6-digit codes sent by email or SMS.
model VerificationCode {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose     CodePurpose
  /// Email address or phone number the code was sent to.
  target      String
  /// HMAC of the code. Null when the SMS provider (Twilio Verify) holds the code.
  codeHash    String?     @map("code_hash")
  attempts    Int         @default(0)
  maxAttempts Int         @default(5) @map("max_attempts")
  sendCount   Int         @default(1) @map("send_count")
  lastSentAt  DateTime    @default(now()) @map("last_sent_at")
  expiresAt   DateTime    @map("expires_at")
  consumedAt  DateTime?   @map("consumed_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("verification_codes")
}

/// Short-lived state between "password OK" and "2FA code OK" during login.
model AuthChallenge {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("auth_challenges")
}

/// Single-use 2FA recovery codes (stored hashed).
model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("recovery_codes")
}

enum SecurityEventType {
  REGISTERED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_2FA_FAILED
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  RECOVERY_CODE_USED
  KYC_SUBMITTED
  WITHDRAWAL_ADDRESS_ADDED
  WITHDRAWAL_REQUESTED
  PASSWORD_CHANGED
  API_KEY_CREATED
  API_KEY_REVOKED
}

/// Append-only security log shown to the user (Security page) and to admins.
model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String?           @map("user_id")
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SecurityEventType
  ip        String?
  userAgent String?           @map("user_agent")
  device    String?
  location  String?
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("security_events")
}

enum KycDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
}

enum KycFileKind {
  ID_FRONT
  ID_BACK
  SELFIE
}

model KycSubmission {
  id              String          @id @default(cuid())
  userId          String          @map("user_id")
  user            User            @relation("KycSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  documentType    KycDocumentType @map("document_type")
  /// ISO 3166-1 alpha-2 country that issued the document.
  documentCountry String          @map("document_country")
  status          KycStatus       @default(PENDING)
  rejectionReason String?         @map("rejection_reason")
  reviewerId      String?         @map("reviewer_id")
  reviewer        User?           @relation("KycReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  submittedAt     DateTime        @default(now()) @map("submitted_at")
  reviewedAt      DateTime?       @map("reviewed_at")

  files KycFile[]

  @@index([status, submittedAt])
  @@index([userId])
  @@map("kyc_submissions")
}

/// Identity document images. Contents are encrypted before storage.
model KycFile {
  id           String        @id @default(cuid())
  submissionId String        @map("submission_id")
  submission   KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kind         KycFileKind
  mimeType     String        @map("mime_type")
  sizeBytes    Int           @map("size_bytes")
  /// SHA-256 of the original (unencrypted) bytes, for integrity checks.
  sha256       String
  /// AES-256-GCM ciphertext (iv + tag + data).
  dataEnc      Bytes         @map("data_enc")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([submissionId])
  @@map("kyc_files")
}

/// Fixed-window rate limit counters, shared across server instances.
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at")

  @@map("rate_limits")
}

// ===========================================================================
// Assets, accounts and the double-entry ledger (Phase 3)
//
// Balances only change through journal entries. Each entry has two or more
// postings whose amounts sum to zero per asset, and the database enforces this
// at commit time. Postings and entries are append-only (UPDATE/DELETE are
// blocked by triggers), and user balances can't go negative (CHECK
// constraint). See the migration `ledger` for the SQL.
// ===========================================================================

enum AssetType {
  FIAT
  CRYPTO
}

model Asset {
  /// Ticker, e.g. "BTC", "USD".
  code          String    @id
  name          String
  type          AssetType
  /// Decimal places used for display and for rounding amounts entered by users.
  decimals      Int
  coingeckoId   String?   @map("coingecko_id")
  binanceSymbol String?   @map("binance_symbol")
  enabled       Boolean   @default(true)
  /// The X/USD trading pair is open (buy/sell/swap/limit).
  tradingEnabled Boolean  @default(true) @map("trading_enabled")
  sortOrder     Int       @default(0) @map("sort_order")

  ledgerAccounts LedgerAccount[]
  postings       Posting[]
  watchlist      WatchlistItem[]

  @@map("assets")
}

enum AccountType {
  TRADING
  SAVINGS
  /// Virtual funds for demo trading. Never counted in real totals, never withdrawable.
  DEMO
}

/// A user-facing account ("Trading", "Savings", ...). Holds one ledger account per asset.
model Account {
  id         String      @id @default(cuid())
  userId     String      @map("user_id")
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  name       String
  type       AccountType
  isDefault  Boolean     @default(false) @map("is_default")
  createdAt  DateTime    @default(now()) @map("created_at")
  archivedAt DateTime?   @map("archived_at")

  ledgerAccounts LedgerAccount[]

  @@unique([userId, name])
  @@index([userId])
  @@map("accounts")
}

/// A balance for one asset. Owned by a user account, or by the platform
/// (`systemCode`, e.g. FEES, CUSTODY, DEV_FAUCET).
model LedgerAccount {
  id            String   @id @default(cuid())
  accountId     String?  @map("account_id")
  account       Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  systemCode    String?  @map("system_code")
  assetCode     String   @map("asset_code")
  asset         Asset    @relation(fields: [assetCode], references: [code])
  balance       Decimal  @default(0) @db.Decimal(38, 18)
  /// Only system accounts (e.g. an external-funds clearing account) may go negative.
  allowNegative Boolean  @default(false) @map("allow_negative")
  createdAt     DateTime @default(now()) @map("created_at")

  postings Posting[]

  @@unique([accountId, assetCode])
  @@unique([systemCode, assetCode])
  @@map("ledger_accounts")
}

enum EntryType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  TRADE
  FEE
  ADJUSTMENT
  REWARD
  DEV_SEED
}

model JournalEntry {
  id             String    @id @default(cuid())
  type           EntryType
  description    String
  /// The user the entry belongs to (or the admin who made an adjustment).
  userId         String?   @map("user_id")
  user           User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Required for manual ADJUSTMENT entries (admin panel, Phase 5).
  reason         String?
  /// Client-supplied key so a double-submitted form posts only once.
  idempotencyKey String?   @unique @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  postings Posting[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("journal_entries")
}

model Posting {
  id              String        @id @default(cuid())
  entryId         String        @map("entry_id")
  entry           JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  ledgerAccountId String        @map("ledger_account_id")
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  assetCode       String        @map("asset_code")
  asset           Asset         @relation(fields: [assetCode], references: [code])
  /// Signed: credit > 0, debit < 0.
  amount          Decimal       @db.Decimal(38, 18)
  /// Ledger account balance immediately after this posting (audit trail).
  balanceAfter    Decimal       @map("balance_after") @db.Decimal(38, 18)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([entryId])
  @@index([ledgerAccountId, createdAt(sort: Desc)])
  @@map("postings")
}

// ===========================================================================
// Watchlist and notifications (Phase 3)
// ===========================================================================

model WatchlistItem {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetCode String   @map("asset_code")
  asset     Asset    @relation(fields: [assetCode], references: [code])
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, assetCode])
  @@map("watchlist_items")
}

enum NotificationType {
  SECURITY
  ACCOUNT
  KYC
  TRANSFER
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  /// Relative in-app link opened when the notification is clicked.
  link      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Web Push subscription for one browser/device.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}


// ===========================================================================
// Funding, trading and withdrawals (Phase 4)
// Every money movement here is also a ledger journal entry; these tables hold
// the workflow state (status, provider references, destinations).
// ===========================================================================

enum PaymentMethod {
  BANK
  CARD
  CRYPTO
  MOBILE_MONEY
}

enum DepositStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model Deposit {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountId     String        @map("account_id")
  method        PaymentMethod
  assetCode     String        @map("asset_code")
  amount        Decimal       @db.Decimal(38, 18)
  fee           Decimal       @db.Decimal(38, 18)
  status        DepositStatus @default(PENDING)
  /// Short reference the customer quotes on a bank transfer.
  reference     String        @unique
  /// Payment provider's ID (Stripe session, mobile money transaction, tx hash).
  providerRef   String?       @unique @map("provider_ref")
  /// Test-mode deposit created without a real provider (never in production).
  sandbox       Boolean       @default(false)
  failureReason String?       @map("failure_reason")
  entryId       String?       @map("entry_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  completedAt   DateTime?     @map("completed_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("deposits")
}

model DepositAddress {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetCode String   @map("asset_code")
  network   String
  address   String
  /// Generated without a custody provider: for testing only, never receives real funds.
  sandbox   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, assetCode])
  @@map("deposit_addresses")
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  OPEN
  FILLED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  userId      String      @map("user_id")
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountId   String      @map("account_id")
  demo        Boolean     @default(false)
  side        OrderSide
  type        OrderType
  baseAsset   String      @map("base_asset")
  quoteAsset  String      @default("USD") @map("quote_asset")
  /// Quantity of the base asset.
  quantity    Decimal     @db.Decimal(38, 18)
  limitPrice  Decimal?    @map("limit_price") @db.Decimal(38, 18)
  status      OrderStatus @default(OPEN)
  fillPrice   Decimal?    @map("fill_price") @db.Decimal(38, 18)
  fee         Decimal?    @db.Decimal(38, 18)
  /// Quote amount held in escrow for an open limit buy (released on fill/cancel).
  escrow      Decimal?    @db.Decimal(38, 18)
  entryId     String?     @map("entry_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  filledAt    DateTime?   @map("filled_at")
  cancelledAt DateTime?   @map("cancelled_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, baseAsset])
  @@map("orders")
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  SENT
  COMPLETED
  REJECTED
}

model Withdrawal {
  id              String           @id @default(cuid())
  userId          String           @map("user_id")
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountId       String           @map("account_id")
  method          PaymentMethod
  assetCode       String           @map("asset_code")
  amount          Decimal          @db.Decimal(38, 18)
  fee             Decimal          @db.Decimal(38, 18)
  /// Destination details (bank account, wallet address, mobile number); sensitive parts encrypted.
  destination     Json
  addressId       String?          @map("address_id")
  status          WithdrawalStatus @default(REQUESTED)
  rejectionReason String?          @map("rejection_reason")
  /// Process on/after this date (scheduled withdrawals).
  scheduledFor    DateTime?        @map("scheduled_for")
  txRef           String?          @map("tx_ref")
  sandbox         Boolean          @default(false)
  holdEntryId     String?          @map("hold_entry_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  reviewAt        DateTime?        @map("review_at")
  approvedAt      DateTime?        @map("approved_at")
  sentAt          DateTime?        @map("sent_at")
  completedAt     DateTime?        @map("completed_at")
  rejectedAt      DateTime?        @map("rejected_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("withdrawals")
}

/// Saved crypto withdrawal addresses. New addresses must be confirmed by email code.
model WithdrawalAddress {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetCode   String    @map("asset_code")
  label       String
  address     String
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([userId, assetCode, address])
  @@map("withdrawal_addresses")
}

// ===========================================================================
// Administration and content (Phase 5)
// ===========================================================================

/// Append-only record of every staff action (enforced by trigger).
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  details    Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

/// Admin-editable platform settings (fees, limits, rewards). Values are validated JSON.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model Promotion {
  id        String   @id @default(cuid())
  message   String
  ctaLabel  String?  @map("cta_label")
  ctaHref   String?  @map("cta_href")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("promotions")
}

enum ArticleKind {
  BLOG
  ACADEMY
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model Article {
  id          String        @id @default(cuid())
  kind        ArticleKind
  slug        String        @unique
  title       String
  excerpt     String
  /// Markdown.
  body        String
  category    String
  level       String?
  readMinutes Int           @default(3) @map("read_minutes")
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([kind, status, publishedAt(sort: Desc)])
  @@map("articles")
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0) @map("sort_order")
  published Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("faq_items")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Reviews submitted by real, signed-in users. Only APPROVED ones are public.
model Testimonial {
  id          String       @id @default(cuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String       @map("display_name")
  rating      Int
  body        String
  status      ReviewStatus @default(PENDING)
  reviewedAt  DateTime?    @map("reviewed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("testimonials")
}

// ===========================================================================
// Rewards, alerts and recurring buys (Phase 6)
// ===========================================================================

/// One click on a referral link (for the affiliate dashboard). IP is hashed, never stored raw.
model ReferralClick {
  id        String   @id @default(cuid())
  code      String
  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([code, createdAt])
  @@map("referral_clicks")
}

/// Bonus paid once per referred customer, when their first qualifying deposit completes.
model ReferralReward {
  id             String   @id @default(cuid())
  referrerId     String   @map("referrer_id")
  referrer       User     @relation("RewardReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  refereeId      String   @unique @map("referee_id")
  referee        User     @relation("RewardReferee", fields: [refereeId], references: [id], onDelete: Restrict)
  referrerAmount Decimal  @map("referrer_amount") @db.Decimal(38, 18)
  refereeAmount  Decimal  @map("referee_amount") @db.Decimal(38, 18)
  entryId        String   @map("entry_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([referrerId])
  @@map("referral_rewards")
}

enum AlertDirection {
  ABOVE
  BELOW
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  CANCELLED
}

model PriceAlert {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetCode   String         @map("asset_code")
  direction   AlertDirection
  targetPrice Decimal        @map("target_price") @db.Decimal(38, 18)
  notifyEmail Boolean        @default(true) @map("notify_email")
  status      AlertStatus    @default(ACTIVE)
  triggeredAt DateTime?      @map("triggered_at")
  triggeredPrice Decimal?    @map("triggered_price") @db.Decimal(38, 18)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([status, assetCode])
  @@index([userId])
  @@map("price_alerts")
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum ScheduleStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model RecurringBuy {
  id           String         @id @default(cuid())
  userId       String         @map("user_id")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId    String         @map("account_id")
  assetCode    String         @map("asset_code")
  amountUsd    Decimal        @map("amount_usd") @db.Decimal(38, 18)
  frequency    Frequency
  nextRunAt    DateTime       @map("next_run_at")
  status       ScheduleStatus @default(ACTIVE)
  lastRunAt    DateTime?      @map("last_run_at")
  lastResult   String?        @map("last_result")
  failureCount Int            @default(0) @map("failure_count")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([status, nextRunAt])
  @@index([userId])
  @@map("recurring_buys")
}

// ===========================================================================
// Support, API keys, listing requests, statements (Phase 7)
// ===========================================================================

enum TicketChannel {
  TICKET
  CHAT
}

enum TicketStatus {
  OPEN
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}

model SupportTicket {
  id            String         @id @default(cuid())
  userId        String         @map("user_id")
  user          User           @relation("TicketCustomer", fields: [userId], references: [id], onDelete: Cascade)
  channel       TicketChannel  @default(TICKET)
  subject       String
  category      String
  status        TicketStatus   @default(OPEN)
  assignedToId  String?        @map("assigned_to_id")
  assignedTo    User?          @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime       @default(now()) @map("last_message_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  messages      SupportMessage[]

  @@index([status, lastMessageAt(sort: Desc)])
  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String        @map("ticket_id")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String        @map("author_id")
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  fromStaff Boolean       @default(false) @map("from_staff")
  body      String
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

enum ApiPermission {
  READ
  TRADE
}

/// API keys for advanced traders. Only an HMAC of the secret is stored.
model ApiKey {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// Public identifier shown in the UI (orb_<prefix>...).
  prefix     String        @unique
  secretHash String        @map("secret_hash")
  permission ApiPermission
  lastUsedAt DateTime?     @map("last_used_at")
  revokedAt  DateTime?     @map("revoked_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@map("api_keys")
}

enum RequestStatus {
  NEW
  REVIEWING
  ACCEPTED
  DECLINED
}

model ListingRequest {
  id          String        @id @default(cuid())
  projectName String        @map("project_name")
  symbol      String
  website     String
  network     String?
  contract    String?
  email       String
  message     String
  userId      String?       @map("user_id")
  status      RequestStatus @default(NEW)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("listing_requests")
}

/// Records that a monthly statement notice was sent (prevents duplicates).
model StatementDispatch {
  userId    String   @map("user_id")
  month     String
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, month])
  @@map("statement_dispatches")
}