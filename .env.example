# =============================================================================
# Orbtrade environment variables
# Copy to .env.local for development:   cp .env.example .env.local
# NEVER commit real secrets. Production values live in your host's secret store.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Never put secrets in them.
# =============================================================================

# --- App ----------------------------------------------------------------------
# Public base URL (used for metadata, email links, WebAuthn origin).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@orbtrade.example
# Shown in the help centre and contact page. Leave blank to hide.
NEXT_PUBLIC_SUPPORT_PHONE=

# --- Market data (Phase 1) ----------------------------------------------------
# CoinGecko works without a key (rate-limited). Add a free Demo key for headroom.
COINGECKO_API_KEY=
# "demo" (default) or "pro". Pro plans also need COINGECKO_API_BASE=https://pro-api.coingecko.com/api/v3
COINGECKO_API_PLAN=demo
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# Real-time prices via Binance's public market-data WebSocket (no key needed).
NEXT_PUBLIC_BINANCE_WS_URL=wss://stream.binance.com:443/stream
# Price history for dashboard charts (Binance public market-data REST, no key needed).
BINANCE_REST_URL=https://data-api.binance.vision

# --- Push notifications (Phase 3): Web Push / VAPID ----------------------------------
# Generate once: npx web-push generate-vapid-keys
# Leave blank to disable push (in-app notifications still work).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:security@yourdomain.com
VAPID_SUBJECT=

# --- Database (Phase 2): Supabase Postgres ------------------------------------
# From the Supabase dashboard: Project Settings -> Database -> Connection string.
# DATABASE_URL (pooled, used by the app): the Transaction pooler URL (port 6543).
#   Append ?pgbouncer=true to it so Prisma disables prepared statements.
# DATABASE_URL_UNPOOLED (direct, used by migrations): the Session pooler / direct
#   URL (port 5432).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Free-form label for the target database. The seed and reset scripts refuse to
# run when this is "production".
DATABASE_ENV=

# --- Auth & security (Phase 2) ------------------------------------------------
# Keys HMACs of session tokens and one-time codes. 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it signs everyone out and invalidates outstanding codes.
SESSION_SECRET=
# 32-byte base64 key for AES-256-GCM encryption of TOTP secrets and KYC files.
# Generate like SESSION_SECRET. BACK IT UP: losing it makes encrypted data unreadable.
DATA_ENCRYPTION_KEY=
# Sign out after this many minutes of inactivity (default 30).
SESSION_IDLE_MINUTES=30
# Maximum session length in hours, even when active (default 12).
SESSION_MAX_HOURS=12

# --- Email codes (Phase 2) ------------------------------------------------------
# resend | sendgrid | console. "console" prints codes to the server log and is
# refused in production.
EMAIL_PROVIDER=console
RESEND_API_KEY=
SENDGRID_API_KEY=
# Must be a sender verified with your provider.
EMAIL_FROM="Orbtrade <no-reply@orbtrade.example>"

# --- SMS codes (Phase 2): Twilio Verify -------------------------------------------
# twilio | console | none. "console" prints codes to the server log and is refused in production.
# "none" (the production default) turns SMS off: onboarding skips phone verification.
# Turning SMS on later sends existing users without a verified phone to that step on their next visit.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Create a Verify service in the Twilio console (starts with VA...).
TWILIO_VERIFY_SERVICE_SID=

# --- Funding & jobs (Phase 4) ---------------------------------------------------------
# Protects GET /api/cron/process: limit-order matching, scheduled withdrawals, price alerts,
# recurring buys and monthly statement notices. Generate like SESSION_SECRET.
# Call it every minute with header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- Tests (Phase 8, optional) ---------------------------------------------------------
# Playwright smoke tests: signed-in checks run only when these are set (dev-branch user without 2FA).
# E2E_BASE_URL=http://localhost:3000
# E2E_EMAIL=
# E2E_PASSWORD=
