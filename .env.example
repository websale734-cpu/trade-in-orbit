# =============================================================================
# Orbtrade environment variables
# Copy to .env.local for development:   cp .env.example .env.local
# NEVER commit real secrets. Production values live in your host's secret store.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Never put secrets in them.
# =============================================================================

# --- App ----------------------------------------------------------------------
# Public base URL (used for metadata, email links, WebAuthn origin).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@orbtrade.example
# Shown in the help centre (Phase 7). Leave blank to hide.
NEXT_PUBLIC_SUPPORT_PHONE=

# Development-only sample content (promo banner, [DEV SAMPLE] reviews, blog cards).
# Ignored when NODE_ENV=production.
DEV_FIXTURES=false

# --- Market data (Phase 1) ----------------------------------------------------
# CoinGecko works without a key (rate-limited). Add a free Demo key for headroom.
COINGECKO_API_KEY=
# "demo" (default) or "pro". Pro plans also need COINGECKO_API_BASE=https://pro-api.coingecko.com/api/v3
COINGECKO_API_PLAN=demo
COINGECKO_API_BASE=https://api.coingecko.com/api/v3
# Real-time prices via Binance's public market-data WebSocket (no key needed).
NEXT_PUBLIC_BINANCE_WS_URL=wss://stream.binance.com:443/stream

# --- Database (Phase 2) -------------------------------------------------------
# Hosted Postgres (Neon / Supabase). Use the pooled URL for the app and the
# direct URL for migrations.
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Auth & security (Phase 2) ------------------------------------------------
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SESSION_SECRET=
# 32-byte base64 key for encrypting sensitive fields at rest (AES-256-GCM).
DATA_ENCRYPTION_KEY=

# --- Email codes (Phase 2): Resend or SendGrid ----------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM="Orbtrade <no-reply@orbtrade.example>"

# --- SMS codes (Phase 2): Twilio Verify -----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Payments (Phase 4) ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
